# Application
APP_URL=http://localhost:3100
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NODE_ENV=development

# Store identity published to customers (footer contact block).
# Leave blank to hide the block until the shop approves the real details.
STORE_CONTACT_LEGAL_NAME=
STORE_CONTACT_ADDRESS=
STORE_CONTACT_PHONE=
STORE_CONTACT_EMAIL=
STORE_CONTACT_TAX_ID=

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Required for production migrations; identify the verified backup artifact.
MIGRATION_BACKUP_REFERENCE=

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3100
CART_TOKEN_SECRET=replace-with-an-independent-32-character-secret
ORDER_LOOKUP_SECRET=replace-with-an-independent-32-character-secret
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-one-time-password
OWNER_NAME=Store Owner

# VNPAY
VNPAY_TMN_CODE=merchant-code
VNPAY_HASH_SECRET=merchant-hash-secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3100/api/payments/vnpay/return
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Object storage (S3-compatible)
S3_ENDPOINT=https://storage.example.com
S3_REGION=auto
S3_BUCKET=masterball-store
S3_ACCESS_KEY_ID=access-key
S3_SECRET_ACCESS_KEY=secret-key
S3_PUBLIC_BASE_URL=https://cdn.example.com

# Transactional email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASSWORD=smtp-password
EMAIL_FROM=MasterBall Store <orders@example.com>

# Scheduled jobs
CRON_SECRET=replace-with-a-long-random-secret
